PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/imperial-co
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@imperialco.biz
ADMIN_PASSWORD=Admin@123456
# Comma-separated for local + Vercel
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# --- Google Sheets product sync (midnight + admin Sync now) ---
# Spreadsheet: Field Mapping → items tab
CRON_SECRET=change-me-to-a-long-random-cron-secret
GOOGLE_SHEETS_SPREADSHEET_ID=1NmrVWn6pWnKDHInWa0dCELFkb1FYMVBobPNPMdGZerM
GOOGLE_SHEETS_RANGE=items!A1:Z
GOOGLE_SHEETS_GID=924637876
# Optional but recommended for private sheets:
# 1) Create a Google Cloud service account
# 2) Enable Google Sheets API
# 3) Share the spreadsheet with the service account email (Viewer)
# 4) Paste the full JSON key as one line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Without a service account, the sheet must be shared as “Anyone with the link” (Viewer)
# so CSV export works.
